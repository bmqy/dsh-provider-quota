{
  "name": "@local/dsh-provider-quota",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "在输入框上方常驻一行，显示有内置适配器的供应商（opencode-go、command-code、本地 codex CLI）的套餐余量：5 小时 / 每周 / 每月窗口的剩余比例与重置倒计时。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "quota",
    "usage",
    "balance",
    "provider"
  ],
  "license": "MIT",
  "author": "bmqy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bmqy/dsh-provider-quota.git"
  },
  "bugs": {
    "url": "https://github.com/bmqy/dsh-provider-quota/issues"
  },
  "homepage": "https://github.com/bmqy/dsh-provider-quota#readme",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "screenshots.json",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
