{
  "name": "@local/dsh-provider-quota",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "在输入框上方和可选的侧栏登录信息上方显示供应商套餐余量（opencode-go、command-code、本地 Codex / Claude Code / Gemini CLI / Antigravity，以及 CLIProxyAPI 内置 OAuth 和支持额度查询的插件认证文件），含剩余比例、重置倒计时与窗口明细；显示选项与 CLIProxyAPI 管理由 DSH 插件设置页管理。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "quota",
    "usage",
    "balance",
    "provider",
    "claude",
    "gemini",
    "antigravity",
    "cli-proxy-api",
    "cliproxyapi",
    "auth-files"
  ],
  "license": "MIT",
  "author": "bmqy",
  "scripts": {
    "test": "node --test test/quota.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bmqy/dsh-provider-quota.git"
  },
  "bugs": {
    "url": "https://github.com/bmqy/dsh-provider-quota/issues"
  },
  "homepage": "https://github.com/bmqy/dsh-provider-quota#readme",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "screenshots.json",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  }
}
